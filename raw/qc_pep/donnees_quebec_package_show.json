_PEP.pdf", "url_type": ""}, {"cache_last_updated": null, "cache_url": null, "created": "2020-05-28T10:54:44.696183", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "## \ud83d\udcd8 Document de r\u00e9f\u00e9rence\r\n<span style=\"display:block; height:1em; overflow:hidden;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> \r\n### Ce document d\u00e9crit les cinq r\u00e9seaux des placettes-\u00e9chantillons permanentes (PEP) \u00e9tablis sur le territoire forestier du Qu\u00e9bec m\u00e9ridional : BAS1, BAS2, SPIM, F\u00c9D\u00c9 et SCOF. Il pr\u00e9sente les objectifs de collecte de mesures de chaque r\u00e9seau et les utilisations possibles des donn\u00e9es. Les caract\u00e9ristiques \u00e9chantillonn\u00e9es \u00e0 l\u2019int\u00e9rieur des PEP au 4e inventaire y sont \u00e9galement pr\u00e9sent\u00e9es.", "format": "PDF", "hash": "", "id": "ad38a38e-0cca-4629-b1f6-6c06d41661b5", "last_modified": "2014-05-31T12:00:00", "metadata_modified": "2025-07-17T18:42:50.198868", "mimetype": "application/pdf", "mimetype_inner": null, "name": "R\u00e9seaux des placettes-\u00e9chantillons permanentes du Qu\u00e9bec m\u00e9ridional ", "package_id": "adb12ba6-4e55-4e4a-8a63-235c48be7865", "position": 6, "relidi_condon_boolee": "n/a", "relidi_condon_datheu": "n/a", "relidi_condon_nombre": "n/a", "relidi_condon_valinc": "n/a", "relidi_confic_epsg": "n/a", "relidi_confic_pascom": "n/a", "relidi_confic_separateur_virgule": "n/a", "relidi_confic_utf8": "n/a", "relidi_description_champs": "n/a", "relidi_ressource_complementaire": [], "resource_type": "support", "size": null, "state": "active", "taille_entier": 4, "tracking_summary": {"total": 29, "recent": 2}, "url": "https://mrnf.gouv.qc.ca/documents/forets/inventaire/Reseaux-PEP.pdf", "url_type": ""}, {"cache_last_updated": null, "cache_url": null, "created": "2020-05-28T10:51:49.568072", "datastore_acti