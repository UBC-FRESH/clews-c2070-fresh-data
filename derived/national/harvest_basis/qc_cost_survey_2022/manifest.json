  "accounting_caveats": [
    {
      "id": "t2_t21_purchased_wood_procurement_cost",
      "tables": [
        "T2",
        "T21"
      ],
      "statement": "T2/T21 Achats de bois (livre) is the buyer-side purchased-wood procurement cost. It includes the wood purchase, transfers to the State, transport/unloading, and road costs where applicable. The 107.22 CAD/m3 SEPM value is therefore not observed log-sale revenue and must not be treated as stumpage or forest-sector revenue."
    },
    {
      "id": "t20_bgad_is_a_parallel_supply_channel",
      "tables": [
        "T20",
        "T21"
      ],
      "statement": "T20's 106.41 CAD/m3 SEPM value is the parallel BGAD supply channel (harvest, road, haul, hosting, other costs, plus transfers). The 107.22 - 106.41 = 0.81 CAD/m3 difference is a procurement-channel cost spread between different respondent samples, not forest-sector net value. The same caution applies to hardwood sawlog (-14.53) and poplar trituration (-9.45)."
    },
    {
      "id": "prccm_rebates_are_inside_transfers_total",
      "tables": [
        "T5",
        "T10",
        "T20",
        "REG"
      ],
      "statement": "PRCCM road rebates are included in T10/T20 transfers_total (SEPM -1.06 = -0.69 - 0.33 - 0.04), not in T20 road. T5 road_total_after_prccm (15.52 SEPM) is already net of PRCCM and must not be combined with T10 transfers_total (25.01), which would double count the rebate. T20/REG road is gross (access_cost_gross, 16.58 SEPM)."
    },
    {
      "id": "t20_excludes_species_gain_loss",
      "tables": [
        "T3",
        "T20",
        "T22"
      ],
      "statement": "T20 excludes species gain/loss by design: SEPM -2.75, hardwood sawlog -1.85, and poplar trituration -6.80 CAD/m3. Those values appear in T3 and in the T22 revenue synthesis. Any comparison of delivered wood value with T20 procurement costs must flag this exclusion; the SEPM item is larger than the entire 0.81 CAD/m3 purchased-vs-BGAD spread."
    }
  ]
